# The following variables define reusable configurations for deployment, providing consistent and predefined
# behaviors for updating, rolling back, and restarting services.

x-deploy-default: &deploy-default
  update_config:
    failure_action: rollback
    parallelism: 1
    delay: 10s
  rollback_config:
    parallelism: 1
    delay: 10s
  restart_policy:
    # any : relance aussi après un arrêt propre (code 0), par exemple lors
    # d'un redémarrage du démon Docker. Avec on-failure, fluentd et cadvisor
    # restaient arrêtés sans aucune erreur (sentry, 20/10/2026).
    condition: any
    window: 360s
    delay: 30s

x-default: &default
  networks:
    - {{ docker_network }}

services:
{% if env_type == 'preview' %}
  # Preview : nginx-proxy découvre dynamiquement les conteneurs des PR
  # (variables VIRTUAL_HOST) et acme-companion obtient leurs certificats.
  reverse_proxy:
    <<: *default
    image: nginxproxy/nginx-proxy:1.11.6
    deploy:
      <<: *deploy-default
      resources:
        limits:
          memory: 128m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - conf:/etc/nginx/conf.d
      - vhost:/etc/nginx/vhost.d
      - html:/usr/share/nginx/html
      - certs:/etc/nginx/certs:ro
      - /opt/app/configs/reverse_proxy/extra-conf.d/preview.conf:/etc/nginx/conf.d/preview.conf:ro
      # Authentification sur le vhost racine, qui ne sert que /_monitoring/*
      - /opt/app/configs/reverse_proxy/locations/monitoring.htpasswd:/etc/nginx/htpasswd/{{ dns_name }}:ro
      - /var/run/docker.sock:/tmp/docker.sock:ro
    labels:
      - autoheal=true
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.txt.{{product_name}}.{{env_type}}.nginx_proxy
        fluentd-async: "true"

  acme-companion:
    <<: *default
    image: nginxproxy/acme-companion:2.8.2
    deploy:
      <<: *deploy-default
      resources:
        limits:
          memory: 128m
    volumes:
      - certs:/etc/nginx/certs:rw
      - acme:/etc/acme.sh
      - /var/run/docker.sock:/var/run/docker.sock:ro
    volumes_from:
      - reverse_proxy
    environment:
      - DEFAULT_EMAIL=misson.apprentissage.devops@gmail.com
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.txt.{{product_name}}.{{env_type}}.acme
        fluentd-async: "true"

  autoheal:
    <<: *default
    image: willfarrell/autoheal:1.2.0
    deploy:
      <<: *deploy-default
      resources:
        limits:
          memory: 128m
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.txt.{{product_name}}.{{env_type}}.autoheal
        fluentd-async: "true"
{% else %}
  reverse_proxy:
    <<: *default
    image: ghcr.io/{{github_organization}}/{{user_group}}_reverse_proxy:{{reverse_proxy_version}}
    deploy:
      <<: *deploy-default
      restart_policy:
        condition: any
        window: 5s
        delay: 5s
      resources:
        limits:
          memory: 1g
      mode: global
    # Ingress port mode (default) is not able to provide user real-ip
    # In order to bypass this, we need to use mode host port mapping
    # But we cannot replicate the service on a single node
    ports:
{% if dns_name is defined %}
      - target: 8080
        published: 80
        protocol: tcp
        mode: host
      - target: 8443
        published: 443
        protocol: tcp
        mode: host
{% endif %}
{% if host_dns_name is defined %}
      - target: 9443
        published: 9443
        protocol: tcp
        mode: host
{% endif %}
    environment:
      - SERVER_NAME={{ dns_name if dns_name is defined else host_dns_name }}
{% if not (certbot | default(true) | bool) %}
      - ACME_INCLUDE=includes/location_none.conf
{% endif %}
{% if host_dns_name is defined %}
      - MONITORING_INCLUDE=includes/location_none.conf
{% endif %}
      - MODSEC_REQ_BODY_LIMIT={{modsec_body_limit}}
      - MODSEC_REQ_BODY_NOFILES_LIMIT=5243904
      - MODSEC_RULE_ENGINE={{modsec_rule_engine}}
    volumes:
{% if certbot | default(true) | bool %}
      # certificats émis par Certbot (ancienne infra) - arborescence live/<fqdn>/ fournie par Certbot
      - /opt/app/system/certbot/conf/:/etc/nginx/ssl/:ro
      - /opt/app/system/certbot/www/:/var/www/certbot/:ro
{% else %}
      # certificats deposes par pki (nouvelle infra) - un sous-repertoire <fqdn>/ par certificat
      - /opt/app/configs/reverse_proxy/ssl/:/etc/nginx/ssl/live/:ro
{% endif %}
      - /opt/app/configs/reverse_proxy/locations/:/etc/nginx/templates/locations/:ro
      - /opt/app/configs/reverse_proxy/system/:/etc/nginx/system/:ro
      - /opt/app/configs/reverse_proxy/extra-conf.d/:/etc/nginx/templates/extra-conf.d/:ro
      - /opt/app/configs/reverse_proxy/owasp-crs/:/etc/modsecurity.d/owasp-crs/rules/:ro
      - /opt/app/configs/reverse_proxy/extra-includes/:/etc/nginx/templates/extra-includes/:ro
      - /opt/app/system/nginx/:/var/log/nginx/:rw
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.nginx.{{product_name}}.{{env_type}}.nginx
        fluentd-async: "true"
{% endif %}

  nodeexporter:
    <<: *default
    image: prom/node-exporter:v1.10.2
    hostname: "{{ host_name }}"
    deploy:
      <<: *deploy-default
      resources:
        limits:
          cpus: "0.50"
          memory: 128m
    command:
      - "--path.procfs=/host/proc"
      - "--path.rootfs=/rootfs"
      - "--path.sysfs=/host/sys"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
      - "--collector.textfile.directory=/var/cron-exporter"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /opt/app/system/cron:/var/cron-exporter:rw
{% if env_type == 'preview' %}
    environment:
      - VIRTUAL_HOST={{ dns_name }}
      - VIRTUAL_PATH=/_monitoring/nodeexporter
      - VIRTUAL_DEST=/metrics
      - VIRTUAL_PORT=9100
      - LETSENCRYPT_HOST={{ dns_name }}
{% endif %}
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.nginx.{{product_name}}.{{env_type}}.nodeexporter
        fluentd-async: "true"

  cadvisor:
    <<: *default
    image: gcr.io/cadvisor/cadvisor:v0.52.1
    deploy:
      <<: *deploy-default
      resources:
        limits:
          cpus: "0.50"
          memory: 128m
    hostname: "{{ host_name }}"
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro,rshared
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro,rshared
      - /dev/disk/:/dev/disk:ro
{% if env_type == 'preview' %}
    environment:
      - VIRTUAL_HOST={{ dns_name }}
      - VIRTUAL_PATH=/_monitoring/cadvisor
      - VIRTUAL_DEST=/metrics
      - VIRTUAL_PORT=8080
      - LETSENCRYPT_HOST={{ dns_name }}
{% endif %}
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        tag: docker.nginx.{{product_name}}.{{env_type}}.cadvisor
        fluentd-async: "true"

  fluentd:
    <<: *default
    deploy:
      <<: *deploy-default
      resources:
        limits:
          cpus: "1.00"
          memory: 1g
    image: ghcr.io/{{github_organization}}/{{user_group}}_fluentd:{{fluentd_version}}
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    ports:
      - "127.0.0.1:24224:24224/tcp"
      - "127.0.0.1:24224:24224/udp"
    volumes:
      - fluentd:/var/log/fluent
      - /opt/app/system/nginx/:/var/log/nginx/:ro
      - /var/log/:/var/log/host/:ro
      - /opt/app/configs/fluentd/:/fluentd/etc/extra-conf.d/:ro
      - /opt/app/system/fluentd/:/pos_file/:rw
      # Container needs to have same localtime as host
      # It's mandatory to intreprete correctly localtime from syslog
      - /etc/localtime:/etc/localtime:ro
      - /etc/timezone:/etc/timezone:ro
    environment:
      PRODUCT_NAME: "{{ product_name }}"
      ENV_TYPE: "{{ env_type }}"
      LOKI_URL: "https://monitoring.apprentissage.beta.gouv.fr/loki"
      LOKI_USERNAME: "monitoring"
      LOKI_PASSWORD: "{{ MONITORING_PASSWORD }}"
      OVH_S3_API_KEY: "{{ OVH_S3_API_KEY }}"
      OVH_S3_API_SECRET: "{{ OVH_S3_API_SECRET }}"
      OVH_S3_BUCKET: "{{ OVH_S3_BUCKET }}"
      OVH_S3_ENDPOINT: "{{ OVH_S3_ENDPOINT }}"
      OVH_S3_REGION: "{{ OVH_S3_REGION }}"
{% if env_type == 'preview' %}
      VIRTUAL_HOST: "{{ dns_name }}"
      VIRTUAL_PATH: "/_monitoring/fluentd"
      VIRTUAL_DEST: "/metrics"
      VIRTUAL_PORT: "24231"
      LETSENCRYPT_HOST: "{{ dns_name }}"
{% endif %}
    logging:
      driver: "local"

volumes:
  fluentd:
{% if env_type == 'preview' %}
  conf:
  vhost:
  html:
  certs:
  acme:
{% endif %}

networks:
  {{docker_network}}:
    name: {{docker_network}}
    attachable: true
    external: true
    driver: overlay
